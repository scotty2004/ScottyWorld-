# Database (Postgres — Neon, Supabase, RDS, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/scottyworld"

# Public site URL
FRONTEND_URL="https://your-domain.example"
NEXT_PUBLIC_SITE_URL="https://your-domain.example"

# Google Sign-In (public client ID — no secret needed for ID-token verification)
GOOGLE_CLIENT_ID=""

# Signs email-verification / password-reset tokens. Use a long random value.
JWT_SECRET=""

# Scotty AI — OpenRouter (or any OpenAI-compatible endpoint via AI_API_URL)
OPENROUTER_API_KEY=""
AI_API_URL="https://openrouter.ai/api/v1/chat/completions"
AI_MODEL="openai/gpt-4o-mini"

PORT=3000

# Scotty Cloud storage — any S3-compatible provider (R2, S3, Backblaze, MinIO)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_PUBLIC_BASE_URL=""

# Transactional email — SMTP
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ScottyWorld <no-reply@your-domain.example>"

# Web push notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@your-domain.example"

# Bot runtime (unchanged — still provider-agnostic)
BOT_RUNTIME_ENDPOINT=""
BOT_RUNTIME_SECRET=""

# Payments (unchanged — still provider-agnostic)
PAYMENT_PROVIDER=""
PAYMENT_SECRET=""
PAYMENT_WEBHOOK_SECRET=""
